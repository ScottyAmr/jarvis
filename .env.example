# ---- LLM backend ----
# Which model provider powers JARVIS: "anthropic" (default) or "gemini".
# Gemini has a free tier: https://aistudio.google.com/app/apikey
# LLM_PROVIDER=anthropic
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_FAST_MODEL=gemini-2.0-flash
# GEMINI_DEEP_MODEL=gemini-2.0-flash
#
# OpenAI-compatible providers (groq/openrouter/together/openai/ollama/lmstudio):
# LLM_API_KEY=...            LLM_FAST_MODEL=...   LLM_DEEP_MODEL=...
# On rate-limit/failure JARVIS auto-switches to these (each has its own daily
# quota, so more models = more total daily capacity, no extra signup):
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-safeguard-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
# For LLM_PROVIDER=custom — point at any self-hosted OpenAI-compatible endpoint
# (vLLM, LocalAI, etc.) not already covered by the presets above:
# LLM_BASE_URL=http://localhost:8000/v1
# Whether the configured OpenAI-compatible model accepts image input (screen
# awareness). Defaults to true; set false if your model/provider can't see images.
# LLM_VISION=true

# Required API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
FISH_API_KEY=your-fish-audio-api-key-here

# Optional: Fish Audio voice model (defaults to JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: Voice engine — controls TTS cost.
#   fish  = Fish Audio cloud, best JARVIS voice, costs money per character (default)
#   say   = macOS built-in `say`, FREE + offline (British voice "Daniel")
#   piper = local Piper neural TTS, FREE + offline, best free quality (see below)
# VOICE_ENGINE=fish
# SAY_VOICE=Daniel
# For piper: pip install piper-tts, download a .onnx voice, then set:
# PIPER_MODEL_PATH=/path/to/en_GB-alan-medium.onnx
# PIPER_BIN=piper

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony

# Optional: Respond in a non-English language, and optionally a region for
# locale-flavored phrasing (e.g. date/number formats, regional word choice).
# Also settable from the frontend's Settings panel — this is just the default.
# JARVIS_LANGUAGE=en
# JARVIS_REGION=

# Optional: Extra folders to scan for git projects JARVIS can work on.
# ~/Desktop and JARVIS's own folder are always included; add more here.
# PROJECT_ROOTS=/Users/you/Developer,/Users/you/code

# Optional: Specific Apple Calendar accounts to read (comma-separated emails)
# If not set, JARVIS reads ALL calendars from Apple Calendar
# CALENDAR_ACCOUNTS=you@gmail.com,work@company.com

# Optional: Whether to skip Claude CLI permission prompts on subprocess calls.
# Defaults to "true" because JARVIS is voice-driven and cannot respond to
# interactive permission prompts (they would silently hang the subprocess).
# Set to "false" to require explicit permission prompts — only useful when
# running JARVIS interactively in a Terminal you can see and respond to.
# JARVIS_SKIP_PERMISSIONS=true

# Optional: Override the auto-detected weather location.
# By default, JARVIS uses your public-IP location (via ipwho.is) and reports
# Fahrenheit. Set these to pin a specific location:
# WEATHER_LOCATION_LABEL=Austin, TX
# WEATHER_LATITUDE=30.2672
# WEATHER_LONGITUDE=-97.7431
# WEATHER_UNIT=fahrenheit  # or "celsius"

# Optional: JARVIS's Playwright-based research browser (browser.py) runs
# headless by default — set false to watch it search/visit pages live.
# JARVIS_BROWSER_HEADLESS=true

# Optional: n8n workflow-automation bridge (integrations/n8n/). Jarvis runs
# fully normally with these unset — [ACTION:N8N] just reports itself
# unconfigured. See integrations/n8n/README.md to set up a local instance.
# N8N_BASE_URL=http://localhost:5678
# N8N_API_KEY=your-n8n-api-key-here
# N8N_WEBHOOK_SECRET=your-webhook-signing-secret-here
# N8N_TIMEOUT_SECONDS=20
